module Funicular
  module VDOM
    type patch_t = Patch
    type child_t = Element | Text | Component | String | Array[Element | Text | Component | String]
    # what a patch carries as a node: a child, or a VNode a caller typed as the base class
    type node_t = VNode | child_t | nil

    class Patch < Data
      NONE: Array[Patch]

      attr_reader op: Symbol
      attr_reader node: node_t
      attr_reader old: node_t
      attr_reader content: String?
      attr_reader props: Hash[Symbol, untyped]?
      attr_reader index: Integer?
      attr_reader new_index: Integer?
      attr_reader patches: Array[Patch]
      attr_reader ops: Array[Patch]
      attr_reader removes: Array[Patch]
      attr_reader instance: Funicular::Component?
      attr_reader vdom: VNode?

      def self.new: (Symbol op, node_t node, node_t old, String? content, Hash[Symbol, untyped]? props, Integer? index, Integer? new_index, Array[Patch] patches, Array[Patch] ops, Array[Patch] removes, Funicular::Component? instance, VNode? vdom) -> Patch
      def self.replace: (node_t node, node_t old) -> Patch
      def self.remove: (node_t node, ?Integer? index) -> Patch
      def self.text: (String content) -> Patch
      def self.props: (Hash[Symbol, untyped] props) -> Patch
      def self.child: (Integer index, Array[Patch] patches) -> Patch
      def self.keep: (Integer index, Integer new_index, Array[Patch] patches) -> Patch
      def self.insert: (Integer new_index, node_t node) -> Patch
      def self.keyed_children: (Array[Patch] ops, Array[Patch] removes) -> Patch
      def self.update_and_rebind: (Funicular::Component instance, Array[Patch] patches, VNode? vdom) -> Patch
    end

    URL_ATTRIBUTES: Array[String]
    SCRIPTING_ELEMENTS: Array[String]

    def self.valid_tag_name?: (String name) -> bool
    def self.text: (untyped child) -> String?
    def self.child_nodes: (JS::Object element) -> Array[untyped]
    def self.valid_attribute_name?: (untyped name) -> bool
    def self.event_attribute?: (String name) -> bool
    def self.unsafe_url?: (String name, untyped value) -> bool
    def self.blocked_attribute?: (String name, untyped value) -> bool

    class VNode
      attr_reader type: Symbol
      attr_reader key: untyped

      def initialize: (Symbol type) -> void
    end

    class Element < VNode
      attr_reader tag: String
      attr_reader props: Hash[Symbol, untyped]
      attr_reader children: Array[child_t]

      def initialize: (String tag, ?Hash[Symbol, untyped] props, ?Array[child_t] children) -> void
      def ==: (untyped other) -> bool
      private def normalize_children: (Array[child_t] children) -> Array[child_t]
    end

    class Text < VNode
      attr_reader content: String

      def initialize: (String content) -> void
      def ==: (untyped other) -> bool
    end

    class Renderer
      @error_boundary_stack: Array[Funicular::ErrorBoundary]

      def initialize: (?JS::Element? doc, ?Runtime? runtime) -> void
      def render: (VDOM::VNode | VDOM::Text | nil vnode, ?JS::Element? parent) -> JS::Object

      private def current_error_boundary: () -> ErrorBoundary?
      private def render_element: (Element element, JS::Element? parent) -> JS::Element
      private def render_text: (VDOM::Text text, JS::Element? parent) -> JS::Object
      private def render_component: (VDOM::Component component_vnode, JS::Element? parent) -> JS::Object
    end

    def self.create_element: (String tag, ?Hash[Symbol, untyped] props, *child_t children) -> Element
    def self.create_text: (String content) -> Text
    def self.render: (VNode vnode, JS::Element container) -> void
    def self.diff: (VNode? old_vnode, VNode? new_vnode) -> Array[patch_t]
    def self.patch: (JS::Object element, Array[patch_t] patches) -> JS::Object

    class Component < VNode
      attr_reader component_class: singleton(Funicular::Component)
      attr_reader props: Hash[Symbol, untyped]
      attr_reader children: Array[child_t]
      attr_accessor instance: Funicular::Component?
      attr_accessor runtime: Runtime?

      def initialize: (singleton(Funicular::Component) component_class, ?Hash[Symbol, untyped] props, ?Array[child_t] children) -> void
      def ==: (untyped other) -> bool
    end
  end
end
